{
  "name": "team-agent-workbench",
  "version": "0.7.11",
  "private": true,
  "description": "Windows team workspace for local Codex, Cursor and Claude Code agents with Linux SFTP sharing",
  "main": "dist/user/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "start": "npm run build && electron dist/user",
    "dev": "npm run start",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-background.mjs",
    "test:background": "node scripts/test-background.mjs",
    "test:provider-paths": "tsx scripts/check-windows-provider-paths.ts",
    "test:handbook-labels": "python scripts/verify-handbook-labels.py",
    "test:handbook-ui": "node scripts/verify-handbook-ui-scenarios.mjs",
    "test:desktop": "tsx --test --test-concurrency=1 tests/launcher.test.ts tests/egress.test.ts tests/codex-process.test.ts",
    "test:ui": "node scripts/smoke.mjs",
    "test:session-ui": "node scripts/session-experience-smoke.mjs",
    "test:handoff-ui": "node scripts/session-handoff-smoke.mjs",
    "test:workflow-ui": "node scripts/workflow-state-smoke.mjs",
    "test:permissions-ui": "node scripts/permissions-smoke.mjs",
    "test:codex-isolation": "tsx scripts/codex-isolation-smoke.ts",
    "test:codex-desktop-sync": "tsx scripts/codex-desktop-sync-smoke.ts",
    "test:codex-desktop-beta": "tsx scripts/codex-desktop-beta-smoke.ts",
    "test:cursor-native-ui": "tsx scripts/cursor-native-ui-smoke.ts",
    "test:cursor-settings": "tsx scripts/cursor-settings-smoke.ts",
    "test:codex-workflow": "tsx scripts/codex-workflow-smoke.ts --ui",
    "test:composer-ui": "node scripts/composer-smoke.mjs",
    "test:composer-tools-ui": "node scripts/composer-tools-smoke.mjs",
    "test:native-sessions-ui": "node scripts/native-session-import-smoke.mjs",
    "test:mcp-protocol": "tsx scripts/codex-mcp-protocol-smoke.ts",
    "test:onboarding-ui": "node scripts/project-onboarding-smoke.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "check": "npm run typecheck && npm test && npm run build:check",
    "start:admin": "npm run build && electron dist/admin",
    "test:local-ui": "node scripts/local-smoke.mjs",
    "test:workgroups-ui": "node scripts/workgroups-smoke.mjs",
    "test:team-groups-ui": "tsx scripts/team-groups-smoke.ts",
    "test:sidebar-ui": "tsx scripts/sidebar-layout-smoke.ts",
    "test:connection-ui": "node scripts/connection-setup-smoke.mjs",
    "test:admin-ui": "node scripts/admin-management-smoke.mjs",
    "test:server-environment-ui": "node scripts/server-environment-smoke.mjs",
    "test:egress-ui": "node scripts/egress-ui-smoke.mjs",
    "test:storage-ui": "node scripts/admin-storage-smoke.mjs",
    "test:competition": "tsx scripts/competition-pilot.ts",
    "test:collaboration-ui": "tsx scripts/collaboration-smoke.ts",
    "test:activity-ui": "tsx scripts/activity-results-smoke.ts",
    "test:result-sessions-ui": "node scripts/result-session-selection-smoke.mjs",
    "test:assignments-files-ui": "tsx scripts/assignments-files-smoke.ts",
    "test:server": "python -m unittest discover -s tests -p test_*.py",
    "test:preparation-permissions-ui": "node scripts/preparation-permissions-smoke.mjs",
    "test:permission-presets": "tsx scripts/permission-presets-smoke.ts",
    "test:session-context-ui": "node scripts/session-context-smoke.mjs",
    "test:questions-ui": "node scripts/questions-smoke.mjs",
    "test:claude-ui": "node scripts/claude-smoke.mjs"
  },
  "dependencies": {
    "@openai/codex": "^0.154.0",
    "archiver": "^8.0.0",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ssh2": "^1.17.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@playwright/test": "^1.63.0",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
